#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package [-C DIR] PLAN_FILE BASE HEAD [OUTFILE] [-- PATH...]
# With `-- PATH...` the commit list, stat and diff are limited to those paths
# (a parallel wave's per-task package, so sibling tasks' commits stay out).
# Default OUTFILE: <repo-root>/.parallel-build/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
# The repository is the one plan-repo names; -C DIR runs as if started in DIR,
# as in plan-workspace.
# Prints the path, commit count, diff size (files, insertions, deletions) and bytes.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
if [ "${1:-}" = "-C" ]; then
  [ -d "${2:-}" ] || { echo "bad -C directory: ${2:-}" >&2; exit 2; }
  cd "$2"
  shift 2
fi

# Split off an optional `-- PATH...` pathspec before counting arguments.
paths=()
args=()
seen_sep=0
for a in "$@"; do
  if [ "$seen_sep" -eq 1 ]; then paths+=("$a")
  elif [ "$a" = "--" ]; then seen_sep=1
  else args+=("$a"); fi
done
if [ "$seen_sep" -eq 1 ] && [ ${#paths[@]} -eq 0 ]; then
  echo "usage: -- needs at least one PATH" >&2
  exit 2
fi
set -- ${args[@]+"${args[@]}"}

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package [-C DIR] PLAN_FILE BASE HEAD [OUTFILE] [-- PATH...]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# Invoke via bash rather than direct exec: some extractors (Python zipfile)
# strip Unix exec bits when unpacking marketplace packages (#2040).
repo=$("${BASH:-bash}" "$here/plan-repo" --with-commit)

git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git -C "$repo" rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

# Range guards (exit 3): a wrong-branch HEAD yields a range that is empty or
# not rooted at BASE; either would silently produce a bogus review package.
git -C "$repo" merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }
[ "$(git -C "$repo" rev-list --count "${base}..${head}" ${paths[@]+-- "${paths[@]}"})" -gt 0 ] || { echo "empty commit range: ${base}..${head}" >&2; exit 3; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("${BASH:-bash}" "$here/plan-workspace" "$plan")
  suffix=""
  if [ ${#paths[@]} -gt 0 ]; then
    suffix="-$(printf '%s\n' "${paths[@]}" | cksum | cut -d' ' -f1)"
  fi
  out="$dir/review-$(git -C "$repo" rev-parse --short "$base")..$(git -C "$repo" rev-parse --short "$head")${suffix}.diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git -C "$repo" log --oneline "${base}..${head}" ${paths[@]+-- "${paths[@]}"}
  echo
  echo "## Files changed"
  git -C "$repo" diff --stat "${base}..${head}" ${paths[@]+-- "${paths[@]}"}
  echo
  echo "## Diff"
  git -C "$repo" diff -U10 "${base}..${head}" ${paths[@]+-- "${paths[@]}"}
} > "$out"

commits=$(git -C "$repo" rev-list --count "${base}..${head}" ${paths[@]+-- "${paths[@]}"})
# Diff size (git's shortstat): the controller picks a scoped re-review's model from it.
size=$(git -C "$repo" diff --shortstat "${base}..${head}" ${paths[@]+-- "${paths[@]}"} | sed 's/^ *//')
echo "wrote ${out}: ${commits} commit(s), ${size:-0 files changed}, $(wc -c < "$out" | tr -d ' ') bytes"
